<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>B2B.CryptoLib.KeyGenTool</RootNamespace>
    <AssemblyName>B2B.CryptoLib.KeyGenTool</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\B2B.CryptoLib\B2B.CryptoLib.csproj" />
    <ProjectReference Include="..\B2B.CryptoLib.KeyGeneration\B2B.CryptoLib.KeyGeneration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\B2B.CryptoLib\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
